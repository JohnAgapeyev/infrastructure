# hermes.env - consumed by apps/ai/hermes via secretGenerator (dashboard
# basic auth is MANDATORY on the container's non-loopback bind).
# OPENROUTER_API_KEY / OPENVIKING_ENDPOINT / OPENVIKING_API_KEY are NOT
# injected by k8s: they live in /srv/appdata/hermes/.env (Hermes's own
# secret store, written during first-run setup - see operations.md "AI ops").
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGEME
# restart-stable dashboard sessions: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGEME
# H2: API server bearer token (the Conduit "API key" field). Required by
# upstream for every API-server deployment (min 8 chars) - the ONLY gate
# on a terminal-capable endpoint. openssl rand -hex 32.
API_SERVER_KEY=CHANGEME
