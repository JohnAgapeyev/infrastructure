# ntfy access token for the alertmanager-ntfy bridge. Mint it AFTER first
# deploying the ntfy server (see apps/observability/notify/kustomization.yaml
# runbook):
#
#   kubectl -n observability exec deploy/ntfy -- ntfy user add --role=admin <user>
#   kubectl -n observability exec deploy/ntfy -- ntfy token add <user>
#
# The token authenticates the bridge's publishes to ntfy (auth-default-access
# is deny-all on the server). Real file is gitignored.
ntfy:
  auth:
    token: tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx