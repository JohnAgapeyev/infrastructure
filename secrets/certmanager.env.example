# Cloudflare API token for cert-manager ACME DNS-01 challenges.
#
# Create at Cloudflare dashboard: My Profile -> API Tokens -> Create Token
# -> "Edit zone DNS" template, then scope it:
#   Permissions:     Zone - DNS - Edit
#                    Zone - Zone - Read
#   Zone Resources:  Include - Specific zone - jg-a.com
# Do NOT use the Global API Key. Rotate by rolling the token in Cloudflare,
# updating this file, and running `make apply-cluster`.
CLOUDFLARE_API_TOKEN=_the_api_token_value_