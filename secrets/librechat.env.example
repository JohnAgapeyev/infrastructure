# librechat.env - consumed by apps/ai/librechat via secretGenerator.
# Generation commands (run on nas, fill secrets/librechat.env):
#   SESSION_SECRET=$(openssl rand -hex 32)
#   JWT_SECRET=$(openssl rand -hex 32)
#   CREDS_KEY=$(openssl rand -hex 32)      # exactly 32 hex chars
#   CREDS_IV=$(openssl rand -hex 16)      # exactly 16 hex chars
#   JWT_REFRESH_SECRET=$(openssl rand -hex 32)   # go-live lesson: without
#   it refresh tokens are TEMPORARY (/app/.env.temp) and logins die on
#   every pod restart (2026-10-26).
# HERMES_API_KEY: MUST equal Hermes's API_SERVER_KEY - the same value
# that lives in /srv/appdata/hermes/.env (H2/C1 lesson: that store wins
# over the k8s env, the two were ALIGNED). Copy it from there
# (kubectl -n ai exec deploy/hermes -- grep '^API_SERVER_KEY' /opt/data/.env)
# and rotate BOTH together, or remove the .env line and let k8s win.
# ALLOW_REGISTRATION: true for FIRST BOOT (create the admin), then flip
# to false (D23) - the LC-4 runbook step.
# MONGO_URI: fixed - the in-cluster no-auth mongo Service, DB "LibreChat"
# (upstream's own compose DB name).
SESSION_SECRET=CHANGEME
JWT_SECRET=CHANGEME
# go-live lesson (2026-10-26): without it refresh tokens are temporary
# (/app/.env.temp) and every pod restart logs users out.
JWT_REFRESH_SECRET=CHANGEME
CREDS_KEY=CHANGEME
CREDS_IV=CHANGEME
MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
HERMES_API_KEY=CHANGEME
ALLOW_REGISTRATION=true