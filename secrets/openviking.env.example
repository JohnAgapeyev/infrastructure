# openviking.env - OPERATOR RECORD ONLY. Nothing consumes this file via
# kustomize: the live values are in /srv/appdata/openviking/ov.conf on the
# host (created at first run with `openviking-server init`, never in git).
OPENVIKING_ROOT_API_KEY=CHANGEME
OPENVIKING_USER_KEY=CHANGEME
# shared with Hermes (all-OpenRouter decision; also in hermes's .env)
OPENROUTER_API_KEY=CHANGEME
# optional: one user key per Hermes profile that runs an isolated memory
# namespace (that profile's own .env holds the live value; this file is
# only the operator's record). Isolation levels: a separate user keeps
# account-shared resources visible; a separate account hides them too.
# OPENVIKING_ISOLATED_PROFILE_KEY_<NAME>=CHANGEME
