# openclaw.env - consumed by apps/ai/openclaw via secretGenerator (openclaw-env).
# OPENCLAW_GATEWAY_TOKEN: Control UI / Gateway auth. openssl rand -hex 32.
# OPENROUTER_API_KEY: the same OpenRouter key Hermes/OpenViking used (D7/D15) -
# chat model + memory-search embeddings.
# Everything else (model choice, memory config, allowedOrigins) is first-run
# product written by `openclaw onboard` into /srv/appdata/openclaw/openclaw.json
# - see apps/ai/openclaw/openclaw.json.example and operations.md "AI ops".
OPENCLAW_GATEWAY_TOKEN=CHANGEME
OPENROUTER_API_KEY=CHANGEME