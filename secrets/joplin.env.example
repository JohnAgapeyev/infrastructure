# joplin.env - consumed by apps/ai/joplin-export (CronJob) via secretGenerator.
# WebDAV sync target of the owner's Joplin - same target the desktop/mobile
# clients use. Use an APP PASSWORD, not the login password:
# Nextcloud -> personal settings -> Security -> "joplin-export-cli".
# VERIFY the path segment matches your Joplin desktop sync configuration.
JOPLIN_SYNC_URL=https://nextcloud.home.jg-a.com/remote.php/dav/files/john/Joplin/
JOPLIN_NC_USER=john
JOPLIN_NC_APP_PASSWORD=CHANGEME
