{
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "GENERATE: openssl rand -hex 32",
    "observability": {
      "metrics": {
        "enabled": true
      }
    }
  },
  "storage": {
    "workspace": "./data",
    "agfs": {
      "backend": "local"
    },
    "vectordb": {
      "backend": "local"
    }
  },
  "embedding": {
    "dense": {
      "provider": "openai",
      "api_base": "https://openrouter.ai/api/v1",
      "api_key": "<OPENROUTER_API_KEY>",
      "model": "qwen/qwen3-embedding-8b",
      "dimension": 4096,
      "encoding_format": "float"
    }
  },
  "vlm": {
    "provider": "openai",
    "api_base": "https://openrouter.ai/api/v1",
    "api_key": "<OPENROUTER_API_KEY>",
    "model": "z-ai/glm-5.3"
  }
}
