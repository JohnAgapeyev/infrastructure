{
  "_comment": "openclaw.json EXAMPLE - documents the steady-state shape actually applied at OC-1 go-live (2026-10-20) via `openclaw config patch --file openclaw.patch.json5` (schema-validated). The REAL file lives on the hostPath (/srv/appdata/openclaw/openclaw.json, first-run onboard product). Model continuity with the disabled Hermes/OpenViking stack (D15/D16): same OpenRouter key (env SecretRef), the owner's OpenViking-era models. Secrets are NOT here: OPENROUTER_API_KEY + OPENCLAW_GATEWAY_TOKEN arrive as env vars from the openclaw-env Secret. meta/wizard/skills/telemetry/onboard blocks omitted.",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "trustedProxies": ["10.42.0.0/16"],
    "controlUi": {
      "allowedOrigins": ["https://openclaw.home.jg-a.com"]
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": { "source": "env", "provider": "default", "id": "OPENROUTER_API_KEY" }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "openrouter/z-ai/glm-5.3-flash" }
    }
  },
  "memory": {
    "search": {
      "provider": "openai-compatible",
      "model": "qwen/qwen3-embedding-8b",
      "remote": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": { "source": "env", "provider": "default", "id": "OPENROUTER_API_KEY" }
      },
      "extraPaths": [
        { "path": "/mnt/joplin-export", "pattern": "**/*.md" }
      ]
    }
  }
}